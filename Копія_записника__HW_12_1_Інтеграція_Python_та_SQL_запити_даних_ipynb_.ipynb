     "text": [
      "0    2003-01\n",
      "1    2003-02\n",
      "2    2003-03\n",
      "3    2003-04\n",
      "4    2003-05\n",
      "Name: order_period, dtype: object\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "from sqlalchemy import text\n",
    "\n",
    "query_task4 = text(\"\"\"\n",
    "WITH monthly_sales AS (\n",
    "    SELECT \n",
    "        CONCAT(\n",
    "            YEAR(o.orderDate), \n",
    "            '-', \n",
    "            LPAD(MONTH(o.orderDate), 2, '0')\n",
    "        ) AS order_period,\n",
    "        YEAR(o.orderDate) AS order_year,\n",
    "        COUNT(DISTINCT o.orderNumber) AS order_count,\n",
    "        SUM(od.quantityOrdered * od.priceEach) AS total_revenue\n",
    "    FROM orders o\n",
    "    JOIN orderdetails od ON o.orderNumber = od.orderNumber\n",
    "    GROUP BY order_period, order_year\n",
    ")\n",
    "SELECT \n",
    "    order_period,\n",
    "    order_count,\n",
    "    total_revenue,\n",
    "    ROUND(\n",
    "        ((total_revenue - LAG(total_revenue) OVER (ORDER BY order_period)) \n",
    "        / LAG(total_revenue) OVER (ORDER BY order_period)) * 100, 2\n",
    "    ) AS mom_growth_pct,\n",
    "    ROUND(\n",
    "        SUM(total_revenue) OVER (\n",
    "            PARTITION BY order_year \n",
    "            ORDER BY order_period\n",
    "        ), 2\n",
    "    ) AS ytd_cumulative_revenue,\n",
    "    ROUND(\n",
    "        AVG(total_revenue) OVER (\n",
    "            ORDER BY order_period \n",
    "            ROWS BETWEEN 2 PRECEDING AND CURRENT ROW\n",
    "        ), 2\n",
    "    ) AS moving_avg_3m,\n",
    "    RANK() OVER (\n",
    "        ORDER BY total_revenue DESC\n",
    "    ) AS revenue_rank\n",
    "FROM monthly_sales\n",
    "ORDER BY order_period;\n",
    "\"\"\")\n",
    "\n",
    "# Виконуємо запит\n",
    "df_task4 = pd.read_sql_query(query_task4, engine)\n",
    "\n",
    "# Перевіряємо перші 5 рядків\n",
    "print(df_task4['order_period'].head())"
   ]
  },
